#!/usr/bin/env bash
# A tiny top-like full-screen program used by the HongSSH test suite.
# It exercises alternate-screen mode, cursor addressing, 16/256 colors and
# single-key input over a real SSH PTY.
restore() {
  printf '\033[?25h\033[?1049l'
}
trap restore EXIT INT TERM
printf '\033[?1049h\033[?25l'
while true; do
  printf '\033[H\033[2J'
  printf '\033[1;36mHongSSH demo top\033[0m  \033[0;33m%s\033[0m\n' "$(date +%T)"
  printf '\033[0;90m────────────────────────────────────────────\033[0m\n'
  printf '  PID  USER       %%CPU  %%MEM  COMMAND\n'
  printf '\033[0;32m 1024  root        2.4   0.8  nginx\033[0m\n'
  printf '\033[0;33m 2048  postgres    1.2   2.1  postgres\033[0m\n'
  printf '\033[0;35m 3072  www         0.4   0.3  php-fpm\033[0m\n'
  printf '\033[0;36m 4096  root        0.1   0.2  sshd\033[0m\n'
  printf '\n\033[1;37mPress q to quit\033[0m\n'
  read -rsn1 -t 1 key
  [ "$key" = "q" ] && break
done
